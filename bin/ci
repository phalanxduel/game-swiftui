#!/usr/bin/env bash

# Phalanx Duel Client - Local CI Pipeline
# Performs full validation: Regen -> Format -> Build -> Sim Management -> Test -> Log Analysis

set -euo pipefail

# --- Configuration ---
SCHEME="PhalanxDuelClient"
LOG_PATH="$(pwd)/.debug_session.log"
export PHALANX_DEBUG_LOG_PATH="$LOG_PATH"
export PHALANX_VERBOSE_LOGGING="true"

echo "🚀 Starting Local CI Pipeline..."

# 1. Preparation
echo "⚙️  Regenerating Project..."
xcodegen generate > /dev/null

echo "🎨 Checking formatting..."
changed_swift_files="$(git diff --name-only HEAD -- '*.swift'; git diff --name-only HEAD^ HEAD -- '*.swift' 2>/dev/null || true)"
if [[ -n "$changed_swift_files" ]]; then
  swiftformat $changed_swift_files --lint --quiet ||
    echo "⚠️  SwiftFormat reported existing style debt; build and tests remain blocking."
else
  echo "   No changed Swift sources to format-check."
fi

echo "🛡️  Linting..."
if command -v swiftlint >/dev/null; then
  swiftlint lint --lenient --quiet \
    PhalanxDuelClient PhalanxDuelClientTests PhalanxDuelClientUITests ||
    echo "⚠️  SwiftLint reported existing style debt; build and tests remain blocking."
else
  echo "⚠️  swiftlint not found, skipping."
fi

# 2. Build and test the macOS app. UI proof remains an explicit, heavier gate.
echo "🏗️  Building macOS app..."
xcodebuild build -scheme "$SCHEME" -quiet

echo "🧪 Running contract and unit tests..."
echo "   (This may take a minute, tailing $LOG_PATH on failure)"

# Clean the debug log before starting
> "$LOG_PATH"

if xcodebuild test \
  -scheme "$SCHEME" \
  -only-testing:PhalanxDuelClientTests \
  -quiet; then
    echo "✅ CI PASS: All tests passed."
else
    echo "❌ CI FAIL: Tests failed or build error."
    echo "--- LAST 50 LINES OF DEBUG LOG ---"
    tail -n 50 "$LOG_PATH"
    echo "----------------------------------"
    exit 1
fi

# 4. Optional: Keep logs tailing if requested
if [ "$1" == "--tail" ]; then
    echo "📋 Tailing logs... (Ctrl+C to stop)"
    tail -f "$LOG_PATH"
fi
